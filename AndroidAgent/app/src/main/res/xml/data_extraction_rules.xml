<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/onboarding_test_profiles.preferences_pb" />
        <exclude domain="sharedpref" path="silverage_secure_credentials.xml" />
        <exclude domain="file" path="datastore/silverage_model_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/silverage_voice_interaction_settings.preferences_pb" />
        <exclude domain="sharedpref" path="silverage_device_identity.xml" />
        <exclude domain="sharedpref" path="silverage_family_contacts.xml" />
        <exclude domain="sharedpref" path="silverage_location_timezone.xml" />
        <exclude domain="file" path="agent/MEMORY.md" />
        <exclude domain="file" path="agent/model-config.json" />
        <exclude domain="file" path="agent/safety-monitor-config.json" />
        <exclude domain="file" path="agent/safety-detection-state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/onboarding_test_profiles.preferences_pb" />
        <exclude domain="sharedpref" path="silverage_secure_credentials.xml" />
        <exclude domain="file" path="datastore/silverage_model_credentials.preferences_pb" />
        <exclude domain="file" path="datastore/silverage_voice_interaction_settings.preferences_pb" />
        <exclude domain="sharedpref" path="silverage_device_identity.xml" />
        <exclude domain="sharedpref" path="silverage_family_contacts.xml" />
        <exclude domain="sharedpref" path="silverage_location_timezone.xml" />
        <exclude domain="file" path="agent/MEMORY.md" />
        <exclude domain="file" path="agent/model-config.json" />
        <exclude domain="file" path="agent/safety-monitor-config.json" />
        <exclude domain="file" path="agent/safety-detection-state.json" />
    </device-transfer>
</data-extraction-rules>
